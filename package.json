{
  "name": "robot-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive serial-robot builder with live kinematics, MuJoCo physics, and teardown views",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/fixtures/run.mjs",
    "robots:fetch": "node scripts/robots/fetch.mjs",
    "robots:verify": "node scripts/robots/verify.mjs",
    "robots:pack": "node scripts/robots/pack.mjs",
    "robots:list": "node scripts/robots/library.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mujoco/mujoco": "^3.17.0",
    "@vercel/analytics": "^2.0.1",
    "katex": "^0.19.1",
    "mediabunny": "^1.65.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhantoker/robot-studio.git"
  }
}
